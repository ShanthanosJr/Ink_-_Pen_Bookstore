{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": ["run", "--project", "Backend/BookShopApi", "--urls", "http://localhost:5050"],
      "port": 5050
    },
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "Frontend/bookshop-client", "run", "dev", "--", "--port", "5173"],
      "env": { "VITE_API_ORIGIN": "http://localhost:5050" },
      "port": 5173
    }
  ]
}
